# GROQ_API_KEY: Optional. Used to synthesize the final chat answer from the
# real agent evidence (Llama 3.3 via Groq). Get one free at https://console.groq.com/keys
# If unset, the backend falls back to a plain template answer built from the same real data.
GROQ_API_KEY="MY_GROQ_API_KEY"

# COPERNICUSMARINE_SERVICE_USERNAME / _PASSWORD: Optional. Used by the
# Temperature agent for real Copernicus Marine SST (the 3rd official data
# source alongside INCOIS and Open-Meteo). Register free at
# https://data.marine.copernicus.eu/register — requires Python's
# `copernicusmarine` CLI installed on the host (`pip install copernicusmarine`).
# If unset, the Temperature agent falls back to INCOIS's live SST grid instead.
COPERNICUSMARINE_SERVICE_USERNAME="MY_COPERNICUS_USERNAME"
COPERNICUSMARINE_SERVICE_PASSWORD="MY_COPERNICUS_PASSWORD"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
